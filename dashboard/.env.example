# Copy to .env (gitignored) to point the dashboard at a different broker or namespace.
# These defaults are the public, anonymous HiveMQ broker — there are no credentials here.
VITE_MQTT_BROKER=wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_TOPIC_PREFIX=resqpack/v1/devices
VITE_MQTT_TOPIC_FILTER=resqpack/v1/devices/#
