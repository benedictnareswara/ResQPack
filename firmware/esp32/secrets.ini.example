; Copy this file to secrets.ini and fill in your own values.
; secrets.ini is gitignored; this example file is committed.
;
; wifi_ssid / wifi_password must be a 2.4 GHz network — the ESP32 has no 5 GHz radio.
; On iPhone that means Personal Hotspot -> Maximize Compatibility (see docs/DEMO.md).
[secrets]
wifi_ssid = your-hotspot-name
wifi_password = your-hotspot-password
device_id = resqpack-esp32-01
